<?xml version="1.0" encoding="utf-8"?>
<!-- DAVx5 (at.bitfire.davdroid) — keep CalDAV/CardDAV sync alive in background -->
<config>
    <allow-in-power-save package="at.bitfire.davdroid" />
    <allow-in-power-save-except-idle package="at.bitfire.davdroid" />
    <allow-in-data-usage-save package="at.bitfire.davdroid" />
    <allow-ignore-background-data-settings package="at.bitfire.davdroid" />
    <allow-unthrottled-location package="at.bitfire.davdroid" />
</config>
